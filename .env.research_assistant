# ============================================================
# Research Assistant configuration
# The assistant has THREE broad user-intention categories:
#   1) CHAT
#   2) RESEARCH
#   3) DOCUMENT_UNDERSTANDING
# Each category has its own configurable retrieval options below.
# This file is separate from .env.deep_research_engine.
# ============================================================

# ------------------------- Local Ollama -----------------------
OLLAMA_BASE_URL=http://127.0.0.1:11434
FOLLOWUP_QUERY_MODEL=qwen3.5:35b-a3b
FOLLOWUP_ANSWER_MODEL=qwen3.5:35b-a3b
FOLLOWUP_QUERY_CTX=6144
FOLLOWUP_QUERY_TOKENS=700
FOLLOWUP_ANSWER_CTX=12288
FOLLOWUP_ANSWER_TOKENS=2500
FOLLOWUP_LLM_TIMEOUT_SECONDS=1200
FOLLOWUP_LLM_HEARTBEAT=15

# ---------------------- Conversation memory -------------------
FOLLOWUP_SUMMARY_MODEL=qwen3.5:35b-a3b
FOLLOWUP_SUMMARY_CTX=8192
FOLLOWUP_SUMMARY_TOKENS=1800
FOLLOWUP_CONVERSATION_SUMMARY_CHARS=6000
FOLLOWUP_CONVERSATION_HISTORY_CHARS=12000
FOLLOWUP_CONVERSATION_RECENT_TURNS=4
FOLLOWUP_CONVERSATION_SUMMARIZE_AFTER_TURNS=4

# ============================================================
# DEEP RESEARCH ENGINE INTEGRATION
# ============================================================

# Shared-workspace handoff target. Usually leave this unchanged.
DEEP_RESEARCH_ENGINE_SCRIPT=deep_research_engine.py

# Mode used when the assistant launches the Deep Research Engine.
#   deep  = full deep-research pipeline
#   short = bounded short-research pipeline
DEEP_RESEARCH_ENGINE_MODE=deep

# Pass the configured mode explicitly when launching the engine.
DEEP_RESEARCH_PASS_MODE=true

# After a successful deep run, refresh the shared research registry, attach the
# completed run to the current conversation, and return to the assistant.
DEEP_RESEARCH_AUTO_RESUME=true

# Optional working directory. Leave blank to use the engine script directory.
DEEP_RESEARCH_WORKING_DIR=

# ============================================================
# THREE BROAD CATEGORIES
# ============================================================

# Ask the user what they want to do at startup.
ASSISTANT_ASK_INTENTION_ON_START=true

# Enable/disable each broad category.
CHAT_CATEGORY_ENABLED=true
RESEARCH_CATEGORY_ENABLED=true
DOCUMENTS_CATEGORY_ENABLED=true

# ============================================================
# 1) NORMAL CHAT
# ============================================================

# Normal chat asks:
#   LLM only
#   or
#   LLM + web search
#
# Set CHAT_ALLOW_WEB_SEARCH=false to remove the web-search option.
CHAT_ALLOW_WEB_SEARCH=true

# Default answer to the web-search question.
# true  = default to LLM + web search
# false = default to LLM only
CHAT_DEFAULT_WEB_SEARCH=false

# ============================================================
# 2) RESEARCH
# ============================================================

# Research asks:
#   Existing completed research project OR New research topic
#   then: include saved research database? yes/no
#   then: keep fresh web search active? yes/no

# Allow the saved research database question.
# When an existing project is selected, this means that project's
# papers/evidence corpus. For a new topic, it searches across saved
# completed research runs.
RESEARCH_ALLOW_DATABASE=true
RESEARCH_DEFAULT_DATABASE=true

# Allow the fresh web-search question.
RESEARCH_ALLOW_WEB_SEARCH=true
RESEARCH_DEFAULT_WEB_SEARCH=true

# Maximum number of saved completed research projects considered when
# a NEW topic requests database search. Lower values are faster.
RESEARCH_DATABASE_MAX_PROJECTS=20

# ============================================================
# 3) DOCUMENT UNDERSTANDING
# ============================================================

# The assistant asks the user to select a document project, then asks:
#   Also use web search? yes/no
DOCUMENTS_ALLOW_WEB_SEARCH=true
DOCUMENTS_DEFAULT_WEB_SEARCH=false

# Require a document project in this category.
DOCUMENTS_REQUIRE_PROJECT=true

# --------------------- External search ------------------------
FOLLOWUP_ALWAYS_REFRESH=true
FOLLOWUP_RECENT_DAYS=7
FOLLOWUP_REGISTRY_PAGE_SIZE=10
FOLLOWUP_LOCAL_PAPER_RESULTS=6
FOLLOWUP_LOCAL_EVIDENCE_RESULTS=8
FOLLOWUP_LOCAL_TECH_RESULTS=6
FOLLOWUP_EXTERNAL_RESULTS_PER_SOURCE=3
FOLLOWUP_EXTERNAL_MAX_WORKERS=4
FOLLOWUP_QUERIES_PER_FAMILY=1
FOLLOWUP_CONTEXT_CHARS=30000

# ---------------------- Quick web search ----------------------
QUICK_QUERY_MODEL=qwen3.5:35b-a3b
QUICK_ANSWER_MODEL=qwen3.5:35b-a3b
QUICK_QUERY_CTX=8192
QUICK_QUERY_TOKENS=1000
QUICK_ANSWER_CTX=12288
QUICK_ANSWER_TOKENS=2500
QUICK_RESULTS_PER_SOURCE=4
QUICK_MAX_WORKERS=4
QUICK_MAX_SOURCE_FAMILIES=6
QUICK_CONTEXT_CHARS=30000

# ---------------------- Personal document RAG -----------------
RAG_CANDIDATE_K=40
RAG_CHUNK_SIZE=1800
RAG_CHUNK_OVERLAP=250
RAG_MAX_FILE_MB=80
RAG_INDEX_ON_START=false

# OCR for scanned/image-based PDFs
RAG_OCR_ENABLED=true
RAG_OCR_DPI=180
RAG_OCR_LANG=eng
RAG_OCR_MIN_PAGE_CHARS=80
RAG_OCR_MIN_NATIVE_COVERAGE=0.65
RAG_OCR_MAX_PAGES=0
RAG_OCR_TIMEOUT_SECONDS=120

# Terminal logging
# false = normal quiet operation
# true  = detailed RAG extraction/retrieval diagnostics
RAG_VERBOSE_LOGGING=false

# Optional hybrid semantic embeddings
RAG_EMBEDDINGS_ENABLED=false
RAG_EMBEDDING_MODEL=nomic-embed-text

# ------------------------- Multimodal image input -------------------------
VISION_ENABLED=true
VISION_MODEL=qwen3.8:27b
VISION_CTX=12288
VISION_TOKENS=3000
VISION_TIMEOUT_SECONDS=1200
VISION_MAX_IMAGE_MB=20
VISION_MAX_IMAGES=4
VISION_SERIAL=true
VISION_SAVE_EVIDENCE=true


# --------------------- Optional search providers --------------
SERPAPI_API_KEY=
YOUTUBE_API_KEY=
GITHUB_TOKEN=
OPENALEX_API_KEY=
SEMANTIC_SCHOLAR_API_KEY=
SEMANTIC_SCHOLAR_ENABLED=true

# ------------------------- User agent --------------------------
RESEARCH_USER_AGENT=LocalResearchAssistant/3.0 (personal academic research tool)
