# Research Reviewer configuration
OLLAMA_BASE_URL=http://127.0.0.1:11434

# Specialist models
REVIEW_GENERAL_MODEL=qwen3.5:35b-a3b
REVIEW_CRITICAL_MODEL=qwq:32b
REVIEW_VISION_MODEL=qwen3.8:27b
REVIEW_HOSTILE_MODEL=qwq:32b

# Review coordinator: decides which specialist needs targeted re-review
REVIEW_COORDINATOR_MODEL=qwq:32b
REVIEW_COORDINATOR_ENABLED=true
REVIEW_COORDINATOR_MAX_ROUNDS=2
REVIEW_COORDINATOR_MAX_ACTIONS_PER_ROUND=5
REVIEW_COORDINATOR_CTX=24576
REVIEW_COORDINATOR_TOKENS=4200
REVIEW_COORDINATOR_TIMEOUT_SECONDS=1800

# Dedicated language review
REVIEW_LANGUAGE_MODEL=qwen3.5:35b-a3b
REVIEW_LANGUAGE_ENABLED=true
REVIEW_LANGUAGE_CTX=16384
REVIEW_LANGUAGE_TOKENS=5000
REVIEW_LANGUAGE_TIMEOUT_SECONDS=1800
REVIEW_LANGUAGE_REVIEW_ALL_CHUNKS=true
REVIEW_HUMANIZE_EXAMPLES=16

# Dedicated AI-style signal audit (not an authorship detector)
REVIEW_AI_STYLE_MODEL=qwen3.5:35b-a3b
REVIEW_AI_STYLE_ENABLED=true
REVIEW_AI_STYLE_CTX=16384
REVIEW_AI_STYLE_TOKENS=4200
REVIEW_AI_STYLE_TIMEOUT_SECONDS=1800

# Thinking controls: enabled for every reviewer agent by default.
# Set a role to false only if you deliberately want a faster/non-reasoning pass.
REVIEW_GENERAL_THINK=true
REVIEW_MICRO_THINK=true
REVIEW_SECTION_THINK=true
REVIEW_DATA_THINK=true
REVIEW_CITATION_THINK=true
REVIEW_LITERATURE_PLAN_THINK=true
REVIEW_LITERATURE_ANALYSIS_THINK=true
REVIEW_FOLLOWUP_THINK=true
REVIEW_REWRITE_THINK=true
REVIEW_CRITICAL_THINK=true
REVIEW_COORDINATOR_THINK=true
REVIEW_LANGUAGE_THINK=true
REVIEW_AI_STYLE_THINK=true
REVIEW_VISION_THINK=true
REVIEW_HOSTILE_THINK=true
REVIEW_REPRODUCIBILITY_THINK=true
REVIEW_EXPERIMENTAL_DESIGN_THINK=true
REVIEW_NOVELTY_THINK=true
REVIEW_STATISTICS_THINK=true
REVIEW_SUITABILITY_THINK=true
REVIEW_TITLE_ABSTRACT_THINK=true
REVIEW_NOMENCLATURE_THINK=true

# Ollama empty-response recovery. Empty final content is retried with a larger
# generation budget, then a final think=false fallback is attempted.
REVIEW_LLM_MAX_RETRIES=0
REVIEW_LLM_RETRY_TOKEN_MULTIPLIER=1.5
REVIEW_LLM_MAX_TOKENS=12000
REVIEW_LLM_FALLBACK_NO_THINK=true

# Local inference
REVIEW_LLM_TIMEOUT_SECONDS=1800
REVIEW_HEARTBEAT_SECONDS=15
REVIEW_GENERAL_CTX=16384
REVIEW_GENERAL_TOKENS=4500
REVIEW_CRITICAL_CTX=24576
REVIEW_CRITICAL_TOKENS=5000
REVIEW_VISION_CTX=12288
REVIEW_VISION_TOKENS=2500
REVIEW_VISION_TIMEOUT_SECONDS=1200
REVIEW_HOSTILE_CTX=24576
REVIEW_HOSTILE_TOKENS=5000
REVIEW_HOSTILE_TIMEOUT_SECONDS=1800

# Document review depth
REVIEW_CHUNK_CHARS=11000
REVIEW_CHUNK_OVERLAP=1200
REVIEW_SECTION_MAX_CHARS=28000
REVIEW_MAX_CITATIONS=250
REVIEW_CITATION_RESULTS=3
REVIEW_REFERENCE_MAX_WEB=120
REVIEW_LITERATURE_QUERIES=10
REVIEW_WEB_RESULTS_PER_QUERY=6
REVIEW_REWRITE_EXAMPLES=12

# Visual verification
REVIEW_VISUAL_REVIEW=true
REVIEW_VISUAL_DPI=144
REVIEW_MAX_VISUAL_PAGES=0
REVIEW_SAVE_PAGE_RENDER=true

# Safety/runtime limits
REVIEW_MAX_PDF_MB=300
REVIEW_WEB_TIMEOUT_SECONDS=30
REVIEW_USER_AGENT=LocalResearchReviewer/1.3 (academic document review workflow)

# Token-repeat recovery
# Handles Ollama errors such as: prediction aborted, token repeat limit reached.
# Normal generations remain deterministic (temperature=0). These settings activate only
# after the repeat-limit failure is detected.
REVIEW_REPEAT_MAX_RECOVERIES=3
REVIEW_REPEAT_TEMPERATURE_1=0.15
REVIEW_REPEAT_TEMPERATURE_2=0.25
REVIEW_REPEAT_FALLBACK_TEMPERATURE=0.15
REVIEW_REPEAT_PENALTY_1=1.10
REVIEW_REPEAT_PENALTY_2=1.15
REVIEW_REPEAT_FALLBACK_PENALTY=1.10
REVIEW_REPEAT_LAST_N=128
REVIEW_REPEAT_FALLBACK_TOKEN_MULTIPLIER=1.5

# Micro-review stage resilience
# After all per-request fallbacks are exhausted, the reviewer continues through the
# next micro chunk when one or two chunks fail. Failed chunks are explicitly recorded
# and surfaced to the coordinator/final arbiter. A third failure aborts by default.
REVIEW_MAX_MICRO_FAILURES_BEFORE_ABORT=2
REVIEW_ABORT_ON_MICRO_FAILURES=true

# Independent specialist-stage resilience. Failed foundational specialists are
# recorded as unavailable and the pipeline continues until this ceiling is exceeded.
REVIEW_MAX_SPECIALIST_FAILURES_BEFORE_ABORT=2
REVIEW_ABORT_ON_SPECIALIST_FAILURES=true

# Timeout-specific recovery
# Timeout #1: 1.5x original timeout, SAME FULL CONTEXT, thinking stays on.
# Timeout #2: 2.0x original timeout, SAME FULL CONTEXT, thinking stays on.
# Timeout #3: same 2.0x timeout/context, thinking off, fallback tokens multiplied by 1.5.
REVIEW_TIMEOUT_FIRST_MULTIPLIER=1.5
REVIEW_TIMEOUT_SECOND_MULTIPLIER=2.0
REVIEW_TIMEOUT_MAX_RECOVERIES=3
REVIEW_TIMEOUT_FALLBACK_NO_THINK=true
REVIEW_TIMEOUT_FALLBACK_TOKEN_MULTIPLIER=1.5

# Additional Ollama failure recovery
REVIEW_OLLAMA_TRANSIENT_RETRIES=3
REVIEW_OLLAMA_RESPONSE_RETRIES=2
REVIEW_OLLAMA_BACKOFF_INITIAL_SECONDS=5
REVIEW_OLLAMA_BACKOFF_MAX_SECONDS=60
REVIEW_OLLAMA_HEALTH_TIMEOUT_SECONDS=10

# Context-size / memory recovery
REVIEW_CONTEXT_ERROR_REDUCTION=0.6666667
REVIEW_CONTEXT_ERROR_MIN=8192
REVIEW_CONTEXT_ERROR_MAX_RECOVERIES=2
REVIEW_OOM_CONTEXT_REDUCTION=0.75
REVIEW_OOM_CONTEXT_MIN=8192
REVIEW_OOM_MAX_RECOVERIES=2

# Accepted-generation truncation recovery. This is distinct from HTTP context overflow:
# when prompt_eval + eval nearly fills num_ctx and done_reason=length, reduce only the
# source payload and keep the full model context unchanged.
REVIEW_STALLED_LENGTH_MAX_RECOVERIES=4
REVIEW_STALLED_LENGTH_MIN_PROMPT_CHARS=12000
REVIEW_STALLED_LENGTH_PROMPT_TARGET_FRACTION=0.70
REVIEW_STALLED_LENGTH_MIN_PROMPT_FRACTION=0.20

# The data reviewer previously supplied up to 50k source characters, which could leave
# too little generation room inside a 16k context. 36k is the safer default; recovery can
# shrink further when Ollama reports context-constrained truncation.
REVIEW_DATA_INPUT_MAX_CHARS=36000
REVIEW_DATA_INPUT_MIN_CHARS=12000

# Model fallback after model-not-found or persistent memory/context failures.
REVIEW_MODEL_FALLBACK_ENABLED=true
REVIEW_GENERAL_FALLBACK_MODEL=
REVIEW_CRITICAL_FALLBACK_MODEL=qwen3.5:35b-a3b
REVIEW_COORDINATOR_FALLBACK_MODEL=qwen3.5:35b-a3b
REVIEW_LANGUAGE_FALLBACK_MODEL=qwen3.5:35b-a3b
REVIEW_AI_STYLE_FALLBACK_MODEL=qwen3.5:35b-a3b
REVIEW_HOSTILE_FALLBACK_MODEL=qwen3.5:35b-a3b
# Leave empty unless you have a vision-capable fallback model.
REVIEW_VISION_FALLBACK_MODEL=

# Web/Crossref retry and academic fallback
REVIEW_WEB_RETRIES=3
REVIEW_WEB_BACKOFF_INITIAL_SECONDS=2
REVIEW_WEB_BACKOFF_MAX_SECONDS=20
REVIEW_CROSSREF_RETRIES=3
REVIEW_CROSSREF_BACKOFF_INITIAL_SECONDS=2
REVIEW_CROSSREF_BACKOFF_MAX_SECONDS=20
REVIEW_WEB_CROSSREF_FALLBACK=true

# -----------------------------------------------------------------------------
# Proactive smart context compression
# The reviewer creates this ONCE per review session and reuses it across specialists.
# The original PDF and extracted text remain unchanged and authoritative.
REVIEW_MODE=full
REVIEW_CONTEXT_SUMMARY_MODEL=qwen3.5:35b-a3b
REVIEW_CONTEXT_SUMMARY_CTX=12288
REVIEW_CONTEXT_SUMMARY_TOKENS=2200
REVIEW_CONTEXT_SUMMARY_INPUT_CHARS=30000
REVIEW_SHORT_CONTEXT_SUMMARY_TOKENS=1600
REVIEW_CONTEXT_REUSE=true
REVIEW_CONTEXT_PACK_VERSION=v2

# FULL mode: large source prompts are proactively compacted before Ollama hits the limit.
REVIEW_FULL_PROACTIVE_CONTEXT=true
REVIEW_FULL_SOURCE_TARGET_GENERAL=28000
REVIEW_FULL_SOURCE_TARGET_CRITICAL=36000
REVIEW_FULL_SOURCE_TARGET_COORDINATOR=32000

# SHORT mode: ALL review stages/pages still run, but source payloads are smaller.
# No stage, agent, visual page, literature query, or coordinator round is skipped.
REVIEW_SHORT_SOURCE_TARGET_GENERAL=12000
REVIEW_SHORT_SOURCE_TARGET_CRITICAL=10000
REVIEW_SHORT_SOURCE_TARGET_COORDINATOR=14000
REVIEW_SHORT_LLM_MAX_TOKENS=3800
REVIEW_SHORT_GENERAL_CTX=8192
REVIEW_SHORT_GENERAL_TOKENS=2200
REVIEW_SHORT_CRITICAL_CTX=12288
REVIEW_SHORT_CRITICAL_TOKENS=3600
REVIEW_SHORT_VISION_CTX=8192
REVIEW_SHORT_VISION_TOKENS=1400
REVIEW_SHORT_COORDINATOR_CTX=12288
REVIEW_SHORT_COORDINATOR_TOKENS=2400
REVIEW_SHORT_LANGUAGE_CTX=8192
REVIEW_SHORT_LANGUAGE_TOKENS=2500
REVIEW_SHORT_AI_STYLE_CTX=8192
REVIEW_SHORT_AI_STYLE_TOKENS=2200
REVIEW_SHORT_HOSTILE_CTX=12288
REVIEW_SHORT_HOSTILE_TOKENS=3000
REVIEW_SHORT_TIMEOUT_SECONDS=900
REVIEW_SHORT_VISION_TIMEOUT_SECONDS=600
REVIEW_SHORT_CONTEXT_RECOVERIES=1
REVIEW_SHORT_STALLED_RECOVERIES=1
REVIEW_SHORT_REPEAT_RECOVERIES=1

# Launch short mode without editing .env:
#   python research_reviewer.py --short
# or:
#   python research_reviewer.py --mode short
